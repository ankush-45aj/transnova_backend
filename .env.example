PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/transnova
CLIENT_ORIGIN=http://localhost:3000
# Set only when behind a known proxy; use its hop count or trusted proxy IP/CIDR values.
# TRUST_PROXY=1
LOG_LEVEL=info
# Paste the entire Firebase service-account JSON on one line. Never commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
# Firebase Web API Key (from Firebase console → Project Settings → General → Web API Key)
# Used ONLY by the dev token helper route. Remove in production.
FIREBASE_WEB_API_KEY=

# Circle Integration Credentials
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# Crossmint Integration Credentials
CROSSMINT_API_KEY=
CROSSMINT_BASE_URL=https://staging.crossmint.com

# Transak On-ramp (use the matching staging credentials and URLs for testing)
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_BASE_URL=https://api-stg.transak.com
TRANSAK_GATEWAY_BASE_URL=https://api-gateway-stg.transak.com
TRANSAK_REFERRER_DOMAIN=localhost:3000
TRANSAK_NETWORK=
# Must match the Circle wallet blockchain that can receive the selected Transak network.
TRANSAK_CIRCLE_BLOCKCHAIN=
