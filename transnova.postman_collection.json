    {
      "name": "Remittance",
      "description": "End-to-End Remittance Pipeline (Flow 1: Transak INR -> USDC -> Crossmint USD ACH).",
      "item": [
        {
          "name": "Initiate Remittance (Flow 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.remittanceId) {",
                  "  pm.environment.set('remittanceId', res.data.remittanceId);",
                  "  console.log('remittanceId saved:', res.data.remittanceId);",
                  "}"
                ]
