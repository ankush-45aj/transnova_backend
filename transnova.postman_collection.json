{
  "info": {
    "_postman_id": "transnova-collection-v1",
    "name": "Transnova API",
    "description": "Complete API collection for the Transnova backend.\n\n## Setup\n1. Import this collection **and** the accompanying `transnova.postman_environment.json` environment file.\n2. Select the **Transnova Local** environment in the top-right dropdown.\n3. **Get a token** â€” run `[DEV] Firebase Signup` (first time) or `[DEV] Firebase Token` (existing user). The `idToken` is automatically saved to `{{firebaseToken}}`.\n4. **Sync your profile** â€” run `Auth / Sync Profile` to create the user document in MongoDB.\n5. Run any other endpoint â€” the `Authorization: Bearer {{firebaseToken}}` header is set on every protected request automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{firebaseToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "ðŸ”§ Dev Helpers (non-production)",
      "description": "Helper routes mounted at /api/v1/dev â€” only active when NODE_ENV != production.\nUse these to obtain Firebase ID tokens without a frontend.",
      "item": [
        {
          "name": "[DEV] Firebase Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.idToken) {",
                  "  pm.environment.set('firebaseToken', res.idToken);",
                  "  pm.environment.set('firebaseUid', res.uid);",
                  "  console.log('firebaseToken saved to environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\",\n  \"displayName\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/dev/firebase-signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "dev",
                "firebase-signup"
              ]
            },
            "description": "Registers a new Firebase user and returns an idToken.\nBody: { email, password, displayName? }\nThe test script automatically stores idToken as {{firebaseToken}}."
          }
        },
        {
          "name": "[DEV] Firebase Token (Sign In)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.idToken) {",
                  "  pm.environment.set('firebaseToken', res.idToken);",
                  "  pm.environment.set('firebaseUid', res.uid);",
                  "  console.log('firebaseToken saved to environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/dev/firebase-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "dev",
                "firebase-token"
              ]
            },
            "description": "Signs in an existing Firebase user and returns a fresh idToken.\nBody: { email, password }\nThe test script automatically stores idToken as {{firebaseToken}}."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns { status: 'ok' } when the server is running."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Endpoints mounted at /api/v1/auth.\nAll require a Firebase ID token in the Authorization header.",
      "item": [
        {
          "name": "Sync Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.user && res.user._id) {",
                  "  pm.environment.set('userId', res.user._id);",
                  "  console.log('userId saved:', res.user._id);",
                  "}",
                  "if (res.wallet && res.wallet.id) {",
                  "  pm.environment.set('circleWalletId', res.wallet.id);",
                  "  console.log('circleWalletId saved:', res.wallet.id);",
                  "}",
                  "if (res.wallet && res.wallet.address) {",
                  "  pm.environment.set('circleAddress', res.wallet.address);",
                  "  console.log('circleAddress saved:', res.wallet.address);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sync",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "sync"
              ]
            },
            "description": "Creates or updates the user document in MongoDB from the Firebase token claims.\nCall this once after sign-up before using any other protected endpoint.\nBody: { displayName? }"
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Returns the authenticated user's profile from MongoDB."
          }
        }
      ]
    },
    {
      "name": "Wallets",
      "description": "Endpoints mounted at /api/v1/wallets.",
      "item": [
        {
          "name": "Create Circle Wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.wallet && res.wallet.walletId) {",
                  "  pm.environment.set('circleWalletId', res.wallet.walletId);",
                  "  console.log('circleWalletId saved:', res.wallet.walletId);",
                  "} else if (res.wallet && res.wallet._id) {",
                  "  pm.environment.set('circleWalletId', res.wallet._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blockchain\": \"MATIC-AMOY\",\n  \"accountType\": \"SCA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/circle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "circle"
              ]
            },
            "description": "Provisions a Circle developer-controlled wallet for the authenticated user.\nBody: { blockchain? (default: MATIC-AMOY), accountType? (default: SCA) }"
          }
        },
