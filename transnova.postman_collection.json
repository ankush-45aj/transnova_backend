          "name": "Get Wallet Balance",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{circleWalletId}}/balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{circleWalletId}}",
                "balance"
              ]
            },
            "description": "Returns the USDC token balance for the specified Circle wallet.\nPath param: walletId â€” stored in {{circleWalletId}} by the Create Circle Wallet request."
          }
        },
        {
          "name": "Validate Blockchain Address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"0xRecipientAddressHere\",\n  \"blockchain\": \"MATIC-AMOY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/validate-address",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "validate-address"
              ]
            },
            "description": "Validates a destination blockchain address via the Circle SDK.\nBody: { address (required), blockchain? (default: MATIC-AMOY) }"
          }
        },
        {
          "name": "Get My Wallet & QR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.wallet && res.wallet.id) {",
                  "  pm.environment.set('circleWalletId', res.wallet.id);",
                  "}",
                  "if (res.wallet && res.wallet.address) {",
                  "  pm.environment.set('circleAddress', res.wallet.address);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "me"
              ]
            },
            "description": "Returns the authenticated user active Circle wallet details along with the constant Base64 Data URL QR code."
          }
        },
        {
          "name": "Get Wallet QR Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/wallets/{{circleWalletId}}/qr",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "wallets",
                "{{circleWalletId}}",
                "qr"
              ]
            },
            "description": "Generates and returns a permanent QR code Data URL for the given wallet address."
          }
        }
      ]
    },
